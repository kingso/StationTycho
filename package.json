{
  "name": "station-tycho",
  "version": "0.1.0",
  "private": true,
  "description": "StationTycho — Cloudflare Worker edge router fronting a Rust/WASM WebGPU lunar visualizer.",
  "scripts": {
    "build:wasm": "wasm-pack build ./crate --target web --out-dir ../dist/pkg",
    "build:static": "node -e \"const fs=require('fs');fs.mkdirSync('dist',{recursive:true});fs.copyFileSync('static/index.html','dist/index.html')\"",
    "build": "npm run build:wasm && npm run build:static",
    "check:dist": "node -e \"if(!require('fs').existsSync('dist/index.html')){console.error('dist/ build not found. Run: npm run build');process.exit(1)}\"",
    "predev": "npm run check:dist",
    "dev": "wrangler dev",
    "dev:remote": "wrangler dev --remote",
    "predeploy:uat": "npm run check:dist",
    "deploy:uat": "wrangler deploy --env uat",
    "predeploy:production": "npm run check:dist",
    "deploy:production": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "typescript": "^5.6.0",
    "wasm-pack": "^0.15.0",
    "wrangler": "^4.151.3"
  },
  "overrides": {
    "undici": "^7.30.1"
  }
}
